{
  "name": "framora",
  "version": "1.0.0",
  "description": "拾帧 Framora - Windows 本地写真照片管理软件",
  "main": "./out/main/index.js",
  "author": "Framora Studio",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node scripts/run-vitest.mjs",
    "build": "electron-vite build",
    "icon": "node scripts/gen-icon.mjs",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "dist": "electron-vite build && electron-builder --win",
    "postinstall": "npm run rebuild:native && node scripts/gen-icon.mjs",
    "test:coverage": "node scripts/run-vitest.mjs --coverage"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.0",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^4.0.3",
    "electron-updater": "^6.8.11",
    "exifr": "^7.1.3",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.1.1",
    "autoprefixer": "^10.4.20",
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.4.49",
    "prettier": "^3.10.1",
    "puppeteer-core": "^25.18.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.1.0",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "better-sqlite3@*": true,
    "electron@*": true,
    "sharp@*": true,
    "esbuild@*": true
  }
}
